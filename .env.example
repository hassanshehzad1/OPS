# PostgreSQL Configuration
POSTGRES_USER=opspilot_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=opspilot_db

# n8n Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# n8n Encryption Key (generate a random 32-character string)
N8N_ENCRYPTION_KEY=your_random_32_character_encryption_key_here

# n8n Basic Authentication (set to true to enable)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_password_here
